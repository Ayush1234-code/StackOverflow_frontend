# Base URL of the backend API. Leave empty to proxy through Vite during development.
# In production this should be the Render API URL, e.g. https://your-api.onrender.com/api.
VITE_API_URL=https://stackoverflow-backend-1-uft2.onrender.com/api

# Where the Vite dev server forwards /api requests while developing.
# Change this to match your backend, e.g. http://localhost:3000 for Express.
VITE_API_PROXY_TARGET=http://localhost:4000
